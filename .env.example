# Local Node-only demo. Copy to .env at the repo root.
# Catalog, auth-mock, proxy, and (later) template/deploy-agent read these via npm run dev.
# Never put real secrets in git — only placeholders here.

# Portkey gateway (real). Leave blank until you have a key; model calls return 503 without it.
PORTKEY_API_KEY=
PORTKEY_SERVICE_KEY=
PORTKEY_GATEWAY_URL=https://api.portkey.ai/v1
PORTKEY_TEAM=
PORTKEY_FEATURE=
PORTKEY_ENVIRONMENT=local
PORTKEY_MODEL=

# Mock OIDC (auth-mock on :9100). Point these at Entra later to leave local mode.
AUTH_ISSUER=http://127.0.0.1:9100
AUTH_AUDIENCE=api://catalog-local
JWKS_URI=http://127.0.0.1:9100/jwks
# Cookie encryption key for oidc-provider sessions (local only; not a production secret).
AUTH_MOCK_COOKIE_KEY=launchpad-local-cookie-key

# Catalog runtime
APP_ENV=local
LOCAL_AUTH_MODE=true
# pglite = embedded Postgres for local demo; pg = real Postgres (docker-compose / Azure).
DB_DRIVER=pglite
PGLITE_PORT=54329
PGLITE_DATA_DIR=.data/pglite
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres

# Audience must be an absolute URI for OAuth resource indicators.
# SPA client id stays a simple public client id (no secret).
AZURE_CLIENT_ID=api://catalog-local
AZURE_SPA_CLIENT_ID=catalog-local
AZURE_AUDIENCE=api://catalog-local
AZURE_TENANT_ID=local

# Proxy (Easy Auth stand-in) — http://catalog.localhost:8080
PROXY_PORT=8080
CATALOG_UPSTREAM=http://127.0.0.1:3000
AUTH_MOCK_URL=http://127.0.0.1:9100
PROXY_ROUTES_FILE=proxy/routes.json

# First Catalog.Approve user on migrate (oid of approver@hni.test from auth-mock/src/users.ts).
CATALOG_BOOTSTRAP_APPROVER_OID=a1000000-0000-4000-8000-000000000003

# Optional: full docker-compose stack (Postgres + catalog image). Not required for npm run dev.
# POSTGRES_PASSWORD=catalog-demo
# BASE_IMAGE=node:22.21.0-bookworm-slim

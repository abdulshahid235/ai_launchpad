# Catalog-only overrides (optional). Prefer the repo-root .env for the local demo.
# Copy values into root .env; do not commit real secrets.

# docker-compose Postgres path (not used when DB_DRIVER=pglite)
POSTGRES_PASSWORD=
BASE_IMAGE=

# Auth / audience (same meaning as root .env)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_SPA_CLIENT_ID=
AZURE_AUDIENCE=
AUTH_ISSUER=
AUTH_AUDIENCE=
JWKS_URI=

# pg = wire Postgres; pglite = local embedded DB via socket
DB_DRIVER=pg

# First Catalog.Approve oid when bootstrapping
CATALOG_BOOTSTRAP_APPROVER_OID=

# CORS allow list (comma-separated origins); leave empty for local defaults
CATALOG_ALLOWED_ORIGINS=

# Bitbucket OIDC validator (pipeline registration). Unused in local mock auth.
CATALOG_BITBUCKET_WORKSPACE=
CATALOG_BITBUCKET_AUDIENCE=
